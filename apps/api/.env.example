# Copy to .env. These values match the db service in docker-compose.yml.
DATABASE_URL=postgresql://getrdone:getrdone@localhost:5432/getrdone
# Only on Neon (the hosted demo): the direct, non-pooled connection, used for
# migrations. Leave unset locally; DATABASE_URL is used instead.
# DATABASE_URL_UNPOOLED=
PORT=3000
# Signs login tokens. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
